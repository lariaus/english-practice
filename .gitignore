# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Cloudflare Worker (cloudflare-worker)
.wrangler

# native-server's local data (sync server URL, etc.) - default location
# when run from the repo root, see README.md "Data storage location"
.app_data

# Shared local data (e.g. dictionary-crawler output), not committed
shared_data

# native-server's CMake build directory (compiled binaries, object files,
# FetchContent-downloaded third-party source) - never committed
native-server/build

# dictionary-crawler's per-word-list progress/status files - local crawl
# state that changes every run, not the word lists themselves (those stay
# tracked as plain .txt files in the same directory)
native-server/dictionary_utils/data/*.json

# Python (ad hoc venvs, e.g. for regenerating native-server's parity test data)
.venv
__pycache__

# Xcode - personal per-developer UI/scheme state, not shared project config
xcuserdata/
DerivedData/
*.xcuserstate

# Claude Code - personal/machine-specific settings, not shared project config
.claude/settings.local.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
